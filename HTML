<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Serene Glow Wellness & Spa</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #5b7065;
            --secondary: #c29b38;
            --accent: #e8d8c8;
            --bg-light: #fbf9f6;
            --dark: #232323;
            --white: #ffffff;
            --whatsapp-color: #25d366;
            --font-main: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-main);
        }

        body {
            background-color: var(--bg-light);
            color: var(--dark);
            line-height: 1.6;
        }

        /* Top WhatsApp Bar */
        .top-bar {
            background-color: var(--whatsapp-color);
            color: var(--white);
            text-align: center;
            padding: 10px 15px;
            font-size: 0.95rem;
            font-weight: 600;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .top-bar a {
            color: var(--white);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .top-bar a:hover {
            text-decoration: underline;
        }

        /* Hero / Vision Section */
        .hero {
            background: linear-gradient(rgba(35, 35, 35, 0.6), rgba(35, 35, 35, 0.6)), 
                        url('https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
            color: var(--white);
            text-align: center;
            padding: 90px 20px;
        }

        .hero h1 {
            font-size: 2.8rem;
            letter-spacing: 2px;
            margin-bottom: 20px;
            font-weight: 300;
            text-transform: uppercase;
        }

        .hero .vision-box {
            max-width: 750px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
            padding: 25px 35px;
            border-radius: 8px;
            border-left: 4px solid var(--secondary);
        }

        .vision-box h3 {
            font-size: 1.2rem;
            color: var(--secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .vision-box p {
            font-size: 1.05rem;
            line-height: 1.7;
            font-weight: 300;
        }

        /* Packages Section */
        .services-container {
            max-width: 1200px;
            margin: 60px auto;
            padding: 0 20px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 2.2rem;
            color: var(--primary);
            font-weight: 400;
        }

        .section-title p {
            color: #777;
            margin-top: 8px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
        }

        .card {
            background: var(--white);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.12);
        }

        .card-img {
            height: 220px;
            width: 100%;
            object-fit: cover;
        }

        .card-body {
            padding: 30px 25px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .card-badge {
            align-self: flex-start;
            background: var(--accent);
            color: var(--dark);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 4px 10px;
            border-radius: 20px;
            margin-bottom: 12px;
            font-weight: 600;
        }

        .card-title {
            font-size: 1.4rem;
            margin-bottom: 8px;
            color: var(--dark);
        }

        .card-price {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .card-price span {
            font-size: 0.9rem;
            font-weight: 400;
            color: #777;
        }

        .card-desc {
            color: #666;
            font-size: 0.95rem;
            margin-bottom: 20px;
        }

        .features-list {
            list-style: none;
            margin-bottom: 25px;
            flex-grow: 1;
        }

        .features-list li {
            padding: 6px 0;
            font-size: 0.9rem;
            color: #555;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .features-list i {
            color: var(--secondary);
            font-size: 0.8rem;
        }

        .btn-book {
            background-color: var(--primary);
            color: var(--white);
            border: none;
            padding: 12px 20px;
            width: 100%;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            transition: background-color 0.2s ease;
        }

        .btn-book:hover {
            background-color: #485950;
        }

        /* Booking Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background-color: var(--white);
            padding: 30px;
            border-radius: 10px;
            width: 90%;
            max-width: 450px;
            position: relative;
        }

        .close-btn {
            position: absolute;
            right: 20px;
            top: 15px;
            font-size: 1.5rem;
            cursor: pointer;
            color: #888;
        }

        .modal-content h3 {
            margin-bottom: 20px;
            color: var(--primary);
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 0.95rem;
        }

        .btn-submit {
            width: 100%;
            background-color: var(--whatsapp-color);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 5px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

        .btn-submit:hover {
            background-color: #20b858;
        }

        footer {
            text-align: center;
            padding: 30px 20px;
            background-color: var(--dark);
            color: #999;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

    <header class="top-bar">
        <a href="https://wa.me/9332467463?text=Hello!%20I%20would%20like%20to%20inquire%20about%20your%20spa%20services." target="_blank">
            <i class="fa-brands fa-whatsapp fa-lg"></i>
            Book via WhatsApp: +91 9332467463 (Available 9:00 AM - 10:00 PM)
        </a>
    </header>

    <section class="hero">
        <h1>'D'69 spa </h1>
        <div class="vision-box">
            <h3>Our Vision</h3>
            <p>
                To provide a tranquil sanctuary where everyday stress dissolves. We commit to restoring your physical balance and mental serenity through authentic holistic therapies, sustainable organic products, and world-class care designed to fit every schedule and lifestyle.
            </p>
        </div>
    </section>

    <main class="services-container">
        <div class="section-title">
            <h2>Select Your Experience</h2>
            <p>Choose an authentic package curated to rejuvenate body and spirit.</p>
        </div>

        <div class="cards-grid">
            <article class="card">
                <img src="https://images.unsplash.com/photo-1519823551278-64ac92734fb1?auto=format&fit=crop&w=600&q=80" alt="Swedish Stress Relief Massage" class="card-img">
                <div class="card-body">
                    <span class="card-badge">Relaxation</span>
                    <h3 class="card-title">Swedish Relief</h3>
                    <div class="card-price">₹1500 <span>/ 45 Mins</span></div>
                    <p class="card-desc">Ideal for clearing daily fatigue and tension through gentle, rhythmic strokes.</p>
                    <ul class="features-list">
                        <li><i class="fa-solid fa-check"></i> Standard essential oil therapy</li>
                        <li><i class="fa-solid fa-check"></i> Upper body tension focus</li>
                        <li><i class="fa-solid fa-check"></i> Complimentary green tea</li>
                    </ul>
                    <button class="btn-book" onclick="openBookingModal('Swedish Relief', 1500)">Book Appointment</button>
                </div>
            </article>

            <article class="card">
                <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=600&q=80" alt="Aromatherapy Deep Tissue Massage" class="card-img">
                <div class="card-body">
                    <span class="card-badge">Most Popular</span>
                    <h3 class="card-title">Aroma Deep Tissue</h3>
                    <div class="card-price">₹2000 <span>/ 60 Mins</span></div>
                    <p class="card-desc">Focuses on deep muscle knots with targeted pressure and custom essential blends.</p>
                    <ul class="features-list">
                        <li><i class="fa-solid fa-check"></i> Customized herbal essential oils</li>
                        <li><i class="fa-solid fa-check"></i> Full body deep muscle recovery</li>
                        <li><i class="fa-solid fa-check"></i> 10-minute steam bath</li>
                    </ul>
                    <button class="btn-book" onclick="openBookingModal('Aroma Deep Tissue', 2000)">Book Appointment</button>
                </div>
            </article>

            <article class="card">
                <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=600&q=80" alt="Signature Stone Spa Therapy" class="card-img">
                <div class="card-body">
                    <span class="card-badge">Premium Care</span>
                    <h3 class="card-title">Ayurvedic Stone Bliss</h3>
                    <div class="card-price">₹2500 <span>/ 75 Mins</span></div>
                    <p class="card-desc">Heated volcanic stones mixed with warm Ayurvedic oils for deep muscle relief.</p>
                    <ul class="features-list">
                        <li><i class="fa-solid fa-check"></i> Basalt hot stone treatment</li>
                        <li><i class="fa-solid fa-check"></i> Head, neck & shoulder acupressure</li>
                        <li><i class="fa-solid fa-check"></i> Steam + Detox herbal infusion</li>
                    </ul>
                    <button class="btn-book" onclick="openBookingModal('Ayurvedic Stone Bliss', 2500)">Book Appointment</button>
                </div>
            </article>
        </div>
    </main>

    <div id="bookingModal" class="modal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeBookingModal()">&times;</span>
            <h3>Book Your Session</h3>
            <form id="bookingForm" onsubmit="handleFormSubmit(event)">
                <div class="form-group">
                    <label for="modalService">Selected Package</label>
                    <input type="text" id="modalService" readonly>
                </div>
                <div class="form-group">
                    <label for="modalPrice">Price (INR)</label>
                    <input type="text" id="modalPrice" readonly>
                </div>
                <div class="form-group">
                    <label for="custName">Your Name</label>
                    <input type="text" id="custName" required placeholder="John Doe">
                </div>
                <div class="form-group">
                    <label for="bookDate">Preferred Date</label>
                    <input type="date" id="bookDate" required>
                </div>
                <div class="form-group">
                    <label for="bookTime">Preferred Time</label>
                    <input type="time" id="bookTime" required>
                </div>
                <button type="submit" class="btn-submit">
                    <i class="fa-brands fa-whatsapp"></i> Confirm via WhatsApp
                </button>
            </form>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 Serene Glow Wellness & Spa. All rights reserved.</p>
    </footer>

    <script>
        // Update your business WhatsApp number here (include country code without + or dashes)
        const SPA_WHATSAPP_NUMBER = "+91 9332467463";

        const modal = document.getElementById('bookingModal');
        const modalService = document.getElementById('modalService');
        const modalPrice = document.getElementById('modalPrice');

        function openBookingModal(serviceName, price) {
            modalService.value = serviceName;
            modalPrice.value = "₹" + price;
            modal.style.display = "flex";
        }

        function closeBookingModal() {
            modal.style.display = "none";
        }

        window.onclick = function(event) {
            if (event.target === modal) {
                closeBookingModal();
            }
        };

        function handleFormSubmit(event) {
            event.preventDefault();

            const service = modalService.value;
            const price = modalPrice.value;
            const name = document.getElementById('custName').value;
            const date = document.getElementById('bookDate').value;
            const time = document.getElementById('bookTime').value;

            // Generate WhatsApp message query
            const textMessage = `*New Spa Booking Request*%0A` +
                                `--------------------------%0A` +
                                `*Customer Name:* ${encodeURIComponent(name)}%0A` +
                                `*Package:* ${encodeURIComponent(service)} (${encodeURIComponent(price)})%0A` +
                                `*Date:* ${encodeURIComponent(date)}%0A` +
                                `*Time:* ${encodeURIComponent(time)}%0A` +
                                `--------------------------%0A` +
                                `Please confirm availability.`;

            const whatsappUrl = `https://wa.me/${SPA_WHATSAPP_NUMBER}?text=${textMessage}`;

            // Open WhatsApp in a new tab
            window.open(whatsappUrl, '_blank');
            closeBookingModal();
        }
    </script>
</body>
</html>
